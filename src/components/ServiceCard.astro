---
import ServiceIcon from "./motifs/ServiceIcon.astro";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  summary: string;
}
const { slug, name, tagline, summary } = Astro.props;
---

<a
  href={`/services/${slug}`}
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-hair bg-surface p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-gold/70 hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
>
  <!-- thin gold top-rule revealed on hover -->
  <span
    class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-gold transition-transform duration-300 group-hover:scale-x-100"
  ></span>

  <ServiceIcon slug={slug} class="h-10 w-10 text-gold" />

  <h3 class="mt-5 font-serif text-xl text-teal">{name}</h3>
  <p class="mt-1 text-[11px] uppercase tracking-widest text-muted">{tagline}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/90">{summary}</p>

  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
    Explore
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
