---
/*
 * ServiceCard.
 *
 * Gate 4d (template-likeness): a bordered rectangle with a floating icon, a
 * title and an "Explore →" link is the exact card every Tailwind marketing
 * template ships with — the grid was the one part of this site a visitor could
 * plausibly have mistaken for a starter theme.
 *
 * The six services are the practice's six shrines, so each icon now stands in
 * a drawn temple niche. It is an arch outline, not a border-radius, which
 * keeps Gate 2d at three radii and D1's palette untouched: one hairline stroke
 * that warms to gold with the rest of the card on hover.
 */
import ServiceIcon from "./motifs/ServiceIcon.astro";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  summary: string;
}
const { slug, name, tagline, summary } = Astro.props;
---

<a
  href={`/services/${slug}`}
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-hair bg-surface p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-gold/70 hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
>
  <!-- thin gold top-rule revealed on hover -->
  <span
    class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-gold transition-transform duration-300 group-hover:scale-x-100"
  ></span>

  <!-- the niche, with the service's icon standing in it -->
  <span class="relative flex h-16 w-14 items-center justify-center">
    <svg
      class="absolute inset-0 h-full w-full text-hair transition-colors duration-300 group-hover:text-gold"
      viewBox="0 0 56 64"
      fill="none"
      stroke="currentColor"
      stroke-width="1.1"
      aria-hidden="true"
    >
      <path d="M3 64V27C3 13.7 14.2 3 28 3s25 10.7 25 24v37" stroke-linecap="round"></path>
      <path d="M28 3V0" stroke-linecap="round" opacity="0.6"></path>
    </svg>
    <ServiceIcon slug={slug} class="relative mb-1 h-8 w-8 text-gold" />
  </span>

  <h3 class="mt-5 font-serif text-2xl text-teal">{name}</h3>
  <p class="mt-1 text-xs uppercase tracking-widest text-muted">{tagline}</p>
  <p class="mt-3 flex-1 leading-relaxed text-ink/90">{summary}</p>

  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
    Explore
    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
