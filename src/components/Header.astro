---
import Container from "./ui/Container.astro";
import Button from "./ui/Button.astro";
import Mandala from "./motifs/Mandala.astro";
import { site } from "../data/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/articles", label: "Articles" },
  { href: "/contact", label: "Contact" },
];

// Normalise the current path (strip trailing slash) for active-link styling.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-hair/70 bg-paper/85 backdrop-blur supports-[backdrop-filter]:bg-paper/70"
>
  <Container class="flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} — home`}>
      <Mandala simple class="h-8 w-8 shrink-0 text-gold" />
      <span class="flex flex-col leading-none">
        <span class="font-serif text-lg text-teal">{site.name}</span>
        <span class="mt-1 text-[10px] uppercase tracking-widest2 text-muted" aria-hidden="true">
          Vastu · Astrology · Numerology
        </span>
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class:list={[
              "text-sm transition-colors hover:text-teal",
              isActive(l.href) ? "text-teal" : "text-ink",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <Button href="/contact">{site.primaryCta}</Button>
    </nav>

    <!-- Mobile navigation (native <details> — fully keyboard accessible, no JS) -->
    <details class="menu relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-hair text-teal"
        aria-label="Toggle menu"
      >
        <svg class="icon-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="icon-close h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-3 w-60 rounded-card border border-hair bg-surface p-3 shadow-lift">
        <nav class="flex flex-col gap-1" aria-label="Primary">
          {
            links.map((l) => (
              <a
                href={l.href}
                aria-current={isActive(l.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2.5 text-sm",
                  isActive(l.href)
                    ? "bg-surface-alt text-teal"
                    : "text-ink hover:bg-surface-alt",
                ]}
              >
                {l.label}
              </a>
            ))
          }
          <Button href="/contact" class="mt-2 w-full">{site.primaryCta}</Button>
        </nav>
      </div>
    </details>
  </Container>
</header>

<style>
  /* Hide the default disclosure triangle and swap the hamburger/close icons. */
  .menu > summary {
    list-style: none;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .menu > summary .icon-close {
    display: none;
  }
  .menu[open] > summary .icon-open {
    display: none;
  }
  .menu[open] > summary .icon-close {
    display: block;
  }
</style>
