---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import PetalDivider from "../motifs/PetalDivider.astro";
import { activeTestimonials, filled } from "../../lib/content";

// Only renders if at least one real (non-placeholder) testimonial exists.
const items = activeTestimonials();
---

{
  items.length > 0 && (
    <Section variant="surface-alt" labelledby="testi-title">
      <Container>
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <p class="text-xs uppercase tracking-widest2 text-muted">Kind words</p>
          <h2 id="testi-title" class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
            In their words
          </h2>
          <PetalDivider class="mt-7" />
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {items.map((t) => (
            <figure class="flex h-full flex-col rounded-card bg-gold-soft p-8">
              <blockquote class="flex-1 font-serif text-lg leading-relaxed text-teal">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-6 text-sm font-medium text-ink">
                {t.name}
                {filled(t.location) && <span class="text-muted"> · {t.location}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </Section>
  )
}
