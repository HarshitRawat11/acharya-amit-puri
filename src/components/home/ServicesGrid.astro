---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import ServiceCard from "../ServiceCard.astro";
import PetalDivider from "../motifs/PetalDivider.astro";
import { site } from "../../data/site";
---

<Section id="services" variant="paper" labelledby="services-title">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs uppercase tracking-widest2 text-muted">What I offer</p>
      <h2 id="services-title" class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
        Six paths of guidance
      </h2>
      <p class="mx-auto mt-4 max-w-prose2 leading-relaxed text-muted">
        Calm, considered counsel across the practices I have studied — each one
        a different lens on the same intention: greater harmony and ease.
      </p>
      <PetalDivider class="mt-7" />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.services.map((s, i) => (
          <div data-reveal style={`transition-delay:${i * 70}ms`}>
            <ServiceCard slug={s.slug} name={s.name} tagline={s.tagline} summary={s.summary} />
          </div>
        ))
      }
    </div>
  </Container>
</Section>
