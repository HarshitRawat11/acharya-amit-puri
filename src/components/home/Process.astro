---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import { site } from "../../data/site";
---

<Section variant="paper" labelledby="process-title">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs uppercase tracking-widest2 text-muted">The journey</p>
      <h2 id="process-title" class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
        How a consultation works
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        A calm, unhurried process — from your first message to ongoing guidance.
      </p>
    </div>

    <ol class="mt-14 grid gap-y-10 gap-x-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        site.process.map((step, i) => (
          <li class="relative" data-reveal style={`transition-delay:${i * 70}ms`}>
            <div class="font-serif text-3xl text-gold">
              {String(i + 1).padStart(2, "0")}
            </div>
            <div class="mt-3 h-px w-10 bg-hair"></div>
            <h3 class="mt-4 font-serif text-lg text-teal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
