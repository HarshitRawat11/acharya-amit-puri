---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import PetalDivider from "../motifs/PetalDivider.astro";
import { site } from "../../data/site";
---

<Section variant="surface-alt" labelledby="faq-title">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs uppercase tracking-widest2 text-muted">Good to know</p>
      <h2 id="faq-title" class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
        Questions, answered
      </h2>
      <PetalDivider class="mt-7" />
    </div>

    <div class="mx-auto mt-12 max-w-3xl space-y-4">
      {
        site.faqs.map((item) => (
          <details class="faq group rounded-card border border-hair bg-surface px-6 shadow-soft">
            <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-serif text-lg text-teal">
              <span>{item.q}</span>
              <svg class="faq-chevron h-5 w-5 shrink-0 text-gold transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pb-5 leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Container>
</Section>

<style>
  /* Hide the default disclosure triangle; rotate our chevron when open. */
  .faq > summary {
    list-style: none;
  }
  .faq > summary::-webkit-details-marker {
    display: none;
  }
  .faq[open] > summary .faq-chevron {
    transform: rotate(180deg);
  }
</style>
