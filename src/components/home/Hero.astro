---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Mandala from "../motifs/Mandala.astro";
import Mascot from "../motifs/Mascot.astro";
import { site } from "../../data/site";
import { whatsappLink, activeStats } from "../../lib/content";

const wa = whatsappLink(
  `Namaste, I would like to book a consultation with ${site.name}.`,
);
// Withheld until at least two are real — see activeStats().
const stats = activeStats();
---

<section class="relative overflow-hidden bg-paper">
  <!-- Sacred mandala watermark, bleeding off the top-right corner -->
  <Mandala
    class="pointer-events-none absolute -right-28 -top-28 h-[460px] w-[460px] text-gold opacity-[0.06] sm:-right-16 sm:-top-20"
  />

  <!-- Two columns from `lg`. The single-column hero left ~320px of the 699px
       band empty with nothing on the right; the mascot now anchors that side.
       Below `lg` it sits ABOVE the text at 160px rather than being hidden.
       Hiding it cost the brand its one distinctive figure on every phone —
       and phones are most of this audience. At 160px it adds ~190px to the
       fold, which still leaves the buttons above it at 375x812 (measured). -->
  <!-- Asymmetric padding on purpose. The section below supplies its own 96px
       of top padding, so a matching 96px here stacked into a 193px void under
       the stats. It reads as a hole rather than breathing room because the
       hero and the services band share the same `paper` background — with no
       tonal change there is nothing for the space to separate. -->
  <Container
    class="relative grid items-center gap-10 pb-6 pt-16 sm:pb-8 sm:pt-20 lg:grid-cols-12 lg:gap-6 lg:pb-10 lg:pt-24"
  >
    <div class="max-w-3xl lg:col-span-7" data-reveal>
      <p class="flex items-center gap-3 text-xs uppercase tracking-widest2 text-muted">
        <span class="h-px w-8 bg-gold"></span>
        Guidance rooted in tradition
      </p>

      <h1 class="mt-6 font-serif text-4xl text-teal sm:text-5xl">
        {site.name}
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        {site.heroValueLine}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href="/contact" size="lg">{site.primaryCta}</Button>
        {
          wa && (
            <Button href={wa} variant="ghost" size="lg" target="_blank" rel="noopener noreferrer">
              Chat on WhatsApp
            </Button>
          )
        }
        <a href="/services" class="text-sm font-medium text-teal underline-offset-4 hover:underline">
          View services →
        </a>
      </div>

      {
        stats.length > 0 && (
          <dl class="mt-14 flex flex-wrap gap-x-12 gap-y-6">
            {stats.map((s) => (
              <div>
                <dt class="font-serif text-3xl text-teal">{s.value}</dt>
                <dd class="text-xs uppercase tracking-widest text-muted">{s.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="order-first lg:order-none lg:col-span-5" data-reveal>
      <Mascot
        halo
        label={`An illustrated likeness of ${site.name}`}
        class="mx-auto h-40 w-40 text-teal sm:h-56 sm:w-56 lg:h-[340px] lg:w-[340px] xl:h-[380px] xl:w-[380px]"
      />
    </div>
  </Container>
</section>
