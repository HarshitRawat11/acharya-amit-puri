---
/*
 * Mascot — a warm, monoline portrait glyph of the Acharya: bald, a long
 * drooping horseshoe moustache, an urdhva-pundra tilak, a rudraksha mala,
 * and serene eyes. No beard — the Acharya is clean-shaven but for the
 * moustache.
 *
 * Drawn in the SAME hand as Mandala / PetalDivider / ServiceIcon: one stroke
 * weight, coloured entirely through `currentColor`. A full-colour cartoon
 * would break the restraint the rest of the brand depends on.
 *
 * The moustache, the tilak mark and the mala beads are the FILLED shapes (as
 * the mandala's dots and bindu are filled). Drawn as strokes the moustache
 * read as a pair of stray curves — at this scale hair only reads with mass.
 *
 * It is a HORSESHOE, not a handlebar: full beneath the nose with both arms
 * descending past the corners of the mouth, matching the Acharya's own. An
 * earlier version swept upward, which was simply wrong about him.
 *
 *   variant="bust"  (default) head, shoulders and shawl — hero / portrait
 *   variant="face"            head only — for anything under ~80px
 *   halo                      adds the eight-petal mandala ring behind
 *   label                     gives it an accessible name; else decorative
 *
 * Colour it with a text utility, e.g. class="text-gold" / "text-teal".
 */
interface Props {
  variant?: "bust" | "face";
  halo?: boolean;
  class?: string;
  /** Inline style, mainly for the dev preview to set an exact pixel size. */
  style?: string;
  label?: string;
}
const {
  variant = "bust",
  halo = false,
  class: className = "",
  style,
  label,
} = Astro.props;

const a11y: Record<string, string> = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };

// Eight petals, matching the ashtadala mandala used across the brand.
const petals = [0, 45, 90, 135, 180, 225, 270, 315];
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  data-motif
  class={className}
  style={style}
  {...a11y}
>
  {
    halo && (
      <g opacity="0.32">
        <circle cx="32" cy="30" r="27" stroke-width="1" />
        {petals.map((a) => (
          <path
            transform={`rotate(${a} 32 30)`}
            d="M32 8.5 C29.4 5.6 29.4 3.1 32 0.6 C34.6 3.1 34.6 5.6 32 8.5 Z"
            stroke-width="1"
          />
        ))}
      </g>
    )
  }

  {
    variant === "bust" && (
      <>
        <path d="M27.8 35.9 V 43.2" />
        <path d="M36.2 35.9 V 43.2" />
        <path d="M13.5 60 C 14.4 50.4 21.2 45.6 32 45.6 C 42.8 45.6 49.6 50.4 50.5 60" />
        {/* angavastram draped over both shoulders */}
        <path d="M24.8 46.6 L 32 53.4 L 39.2 46.6" />
        <path d="M19.2 48.6 C 18.4 52.6 18.1 56.2 18.2 60" />
        <path d="M44.8 48.6 C 45.6 52.6 45.9 56.2 45.8 60" />
        {/* rudraksha mala — the clearest mark of an acharya at this scale */}
        <path d="M26.2 46.0 C 27.2 51.2 36.8 51.2 37.8 46.0" stroke-width="1" />
        {[
          [26.5, 46.9], [27.6, 49.0], [29.4, 50.3],
          [32, 50.8], [34.6, 50.3], [36.4, 49.0], [37.5, 46.9],
        ].map(([cx, cy]) => (
          <circle cx={cx} cy={cy} r="0.85" fill="currentColor" stroke="none" />
        ))}
      </>
    )
  }

  {/* head */}
  <ellipse cx="32" cy="24" rx="11.8" ry="12.7" />
  <path d="M20.4 21.6 C 17.9 21.4 17.4 26.6 20.4 27.6" />
  <path d="M43.6 21.6 C 46.1 21.4 46.6 26.6 43.6 27.6" />

  {/* tilak — an urdhva pundra: two fine uprights meeting in a rounded base,
      with the filled mark between them. Reads as an acharya's brow mark
      rather than the single stroke it was, which looked like a smudge. */}
  <path d="M30.2 12.6 C 30.0 15.4 30.4 17.0 32 18.2 C 33.6 17.0 34.0 15.4 33.8 12.6" />
  <ellipse cx="32" cy="15.4" rx="0.85" ry="2.2" fill="currentColor" stroke="none" />

  {/* brows */}
  <path d="M25.3 21.2 C 26.8 19.9 29 19.9 30.3 21.1" />
  <path d="M38.7 21.2 C 37.2 19.9 35 19.9 33.7 21.1" />

  {/* eyes, gently lowered */}
  <path d="M26.3 24.4 C 27.5 25.7 29.1 25.7 30.3 24.4" />
  <path d="M37.7 24.4 C 36.5 25.7 34.9 25.7 33.7 24.4" />

  {/* a short nose, so the moustache has room to carry real weight */}
  <path d="M32 25.2 V 28.0 C 32 28.8 32.7 29.1 33.3 28.9" />

  {/* The moustache. Full beneath the nose, both arms hanging to y 42.6 — 5.9
      below the chin at 36.7, and 3 clear of the shoulders at 45.6.

      The arms TAPER to points rather than staying thick the whole way down.
      At an even weight this much length reads as a dark mass competing with
      the face; tapering buys the length from the shape instead of from bulk.

      Sampled down the arms, the inner edges run x 25.4 → 22.4 on the left and
      38.6 → 41.6 on the right, always outside the neck lines at x 27.8 and
      36.2, so nothing crosses. */}
  <path
    fill="currentColor"
    stroke="none"
    d="M22.2 42.6 C 20.6 37.0 20.8 32.6 25.2 29.6 C 28.0 28.6 36.0 28.6 38.8 29.6 C 43.2 32.6 43.4 37.0 41.8 42.6 C 41.2 37.2 40.0 34.2 37.4 32.8 C 35.2 32.2 28.8 32.2 26.6 32.8 C 24.0 34.2 22.8 37.2 22.2 42.6 Z"
  />

  {/* mouth, framed between the descending arms */}
  <path d="M30.2 34.8 C 31.2 35.6 32.8 35.6 33.8 34.8" />
</svg>
