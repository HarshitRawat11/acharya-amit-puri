---
/*
 * Mascot — a warm, monoline portrait glyph of the Acharya: bald, a long
 * handlebar moustache, serene downcast eyes, a tilak on the brow.
 *
 * Drawn in the SAME hand as Mandala / PetalDivider / ServiceIcon: one stroke
 * weight, coloured entirely through `currentColor`. A full-colour cartoon
 * would break the restraint the rest of the brand depends on.
 *
 * The moustache is the one FILLED shape (as the mandala's dots and bindu are
 * filled). Drawn as strokes it read as a pair of stray curves — at this scale
 * hair only reads when it has mass. It is ~29 units wide against a 23.6-unit
 * face, so it sweeps clearly past the cheeks, and its tips turn up.
 *
 *   variant="bust"  (default) head, shoulders and shawl — hero / portrait
 *   variant="face"            head only — for anything under ~80px
 *   halo                      adds the eight-petal mandala ring behind
 *   label                     gives it an accessible name; else decorative
 *
 * Colour it with a text utility, e.g. class="text-gold" / "text-teal".
 */
interface Props {
  variant?: "bust" | "face";
  halo?: boolean;
  class?: string;
  label?: string;
}
const {
  variant = "bust",
  halo = false,
  class: className = "",
  label,
} = Astro.props;

const a11y: Record<string, string> = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };

// Eight petals, matching the ashtadala mandala used across the brand.
const petals = [0, 45, 90, 135, 180, 225, 270, 315];
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  data-motif
  class={className}
  {...a11y}
>
  {
    halo && (
      <g opacity="0.32">
        <circle cx="32" cy="30" r="27" stroke-width="1" />
        {petals.map((a) => (
          <path
            transform={`rotate(${a} 32 30)`}
            d="M32 8.5 C29.4 5.6 29.4 3.1 32 0.6 C34.6 3.1 34.6 5.6 32 8.5 Z"
            stroke-width="1"
          />
        ))}
      </g>
    )
  }

  {
    variant === "bust" && (
      <>
        <path d="M27.8 35.6 V 43.2" />
        <path d="M36.2 35.6 V 43.2" />
        <path d="M13.5 60 C 14.4 50.4 21.2 45.6 32 45.6 C 42.8 45.6 49.6 50.4 50.5 60" />
        {/* shawl draped over the shoulders */}
        <path d="M24.8 46.6 L 32 53.4 L 39.2 46.6" />
        <path d="M19.2 48.6 C 18.4 52.6 18.1 56.2 18.2 60" />
        <path d="M44.8 48.6 C 45.6 52.6 45.9 56.2 45.8 60" />
      </>
    )
  }

  {/* head */}
  <ellipse cx="32" cy="24" rx="11.8" ry="12.4" />
  <path d="M20.4 21.6 C 17.9 21.4 17.4 26.6 20.4 27.6" />
  <path d="M43.6 21.6 C 46.1 21.4 46.6 26.6 43.6 27.6" />

  {/* tilak — a small filled mark, kept clear of the nose so it reads as a
      brow mark rather than a stalk */}
  <ellipse cx="32" cy="16" rx="0.95" ry="1.9" fill="currentColor" stroke="none" />

  {/* brows */}
  <path d="M25.3 21.5 C 26.8 20.2 29 20.2 30.3 21.4" />
  <path d="M38.7 21.5 C 37.2 20.2 35 20.2 33.7 21.4" />

  {/* eyes, gently lowered */}
  <path d="M26.3 24.5 C 27.5 25.8 29.1 25.8 30.3 24.5" />
  <path d="M37.7 24.5 C 36.5 25.8 34.9 25.8 33.7 24.5" />

  {/* a short nose, so the moustache has room to carry real weight */}
  <path d="M32 25.4 V 28.2 C 32 29.0 32.7 29.3 33.3 29.1" />

  {/* the moustache — the signature. No mouth: it sits beneath. */}
  <path
    fill="currentColor"
    stroke="none"
    d="M32 29.6 C 28.9 29.9 25.8 30.9 22.9 32.2 C 20.7 33.2 19.3 32.7 18.9 30.6 C 18.6 29.3 17.3 29.6 17.6 31.1 C 18.4 35.6 21.7 37.6 25.5 36.7 C 27.9 36.1 29.9 35.4 32 35.0 C 34.1 35.4 36.1 36.1 38.5 36.7 C 42.3 37.6 45.6 35.6 46.4 31.1 C 46.7 29.6 45.4 29.3 45.1 30.6 C 44.7 32.7 43.3 33.2 41.1 32.2 C 38.2 30.9 35.1 29.9 32 29.6 Z"
  />
</svg>
