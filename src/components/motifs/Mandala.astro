---
/*
 * Mandala — the brand's core sacred-geometry motif (ashtadala / eight-petal
 * lotus mandala with celestial dots). Always line-only; colour it with a text
 * utility (e.g. class="text-gold"). Decorative by default (aria-hidden).
 *   simple : compact crest variant for small sizes (~28px) — fewer rings.
 *   label  : pass to give it an accessible name (otherwise it's decorative).
 */
interface Props {
  simple?: boolean;
  class?: string;
  label?: string;
}
const { simple = false, class: className = "", label } = Astro.props;
const a11y: Record<string, string> = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };

const angles = [0, 45, 90, 135, 180, 225, 270, 315];
// Celestial dots at the 8 cardinal/intercardinal points (radius 88 of 100).
const dots: [number, number][] = [
  [100, 12], [162.2, 37.8], [188, 100], [162.2, 162.2],
  [100, 188], [37.8, 162.2], [12, 100], [37.8, 37.8],
];
---

{
  simple ? (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" data-motif class={className} {...a11y}>
      <circle cx="16" cy="16" r="13" />
      {angles.map((a) => (
        <path transform={`rotate(${a} 16 16)`} d="M16 11 C13.5 9 13.5 7 16 5 C18.5 7 18.5 9 16 11 Z" />
      ))}
      <circle cx="16" cy="16" r="2" fill="currentColor" stroke="none" />
    </svg>
  ) : (
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1" data-motif class={className} {...a11y}>
      <circle cx="100" cy="100" r="94" />
      <circle cx="100" cy="100" r="82" />
      <circle cx="100" cy="100" r="34" />
      {angles.map((a) => (
        <path transform={`rotate(${a} 100 100)`} d="M100 60 C86 46 86 34 100 20 C114 34 114 46 100 60 Z" />
      ))}
      {dots.map(([x, y]) => (
        <circle cx={x} cy={y} r="2.6" fill="currentColor" stroke="none" />
      ))}
      <circle cx="100" cy="100" r="5" fill="currentColor" stroke="none" />
    </svg>
  )
}
