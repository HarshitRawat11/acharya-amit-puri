---
/*
 * BaseLayout — shared HTML shell: self-hosted fonts, full SEO head
 * (title/description, canonical, Open Graph, Twitter, JSON-LD structured data),
 * header, footer, and the gentle reveal-on-scroll enhancement.
 */
import "@fontsource/marcellus"; // headings — self-hosted, single weight
import "@fontsource-variable/inter"; // body — self-hosted variable font
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { isFilled, activeSocials } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Override the social-share image (site-root path or absolute URL). */
  ogImage?: string;
  /** Extra JSON-LD objects to inject for this page (e.g. Service schema). */
  structuredData?: Record<string, unknown>[];
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title = site.seo.defaultTitle,
  description = site.seo.defaultDescription,
  ogImage = site.seo.ogImage,
  structuredData = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const origin = new URL(Astro.site!).origin;
const socials = activeSocials().map((s) => s.href);

// ── Site-wide structured data ───────────────────────────────────────────────
// Contact fields are included ONLY when they have real (non-placeholder) values,
// so we never publish "{{PHONE}}" etc. into the schema.
const personId = `${origin}/#person`;
const serviceId = `${origin}/#service`;
const knowsAbout = [
  "Vastu Shastra",
  "Vedic Astrology (Jyotish)",
  "Numerology",
  "Ayurvedic Prakriti",
  "Palmistry",
];

const person = {
  "@type": "Person",
  "@id": personId,
  name: site.name,
  alternateName: "Amit Puri",
  url: `${origin}/`,
  jobTitle: "Vastu Consultant, Vedic Astrologer & Numerologist",
  description:
    "Acharya Amit Puri offers consultations in Vastu Shastra, Vedic astrology (kundli reading), numerology, Ayurvedic Prakriti and palm reading.",
  knowsAbout,
  ...(isFilled(site.contact.email) ? { email: site.contact.email } : {}),
  ...(isFilled(site.contact.phone) ? { telephone: site.contact.phone } : {}),
  ...(socials.length ? { sameAs: socials } : {}),
};

const professionalService = {
  "@type": "ProfessionalService",
  "@id": serviceId,
  name: site.name,
  url: `${origin}/`,
  image: ogImageUrl,
  description: site.seo.defaultDescription,
  founder: { "@id": personId },
  areaServed: "India",
  knowsAbout,
  // Tells search engines what is actually offered, rather than leaving them
  // to infer it from page copy. Built from the same six services as the site.
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Consultations",
    itemListElement: site.services.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.name,
        serviceType: s.tagline,
        description: s.summary,
        url: `${origin}/services/${s.slug}/`,
      },
    })),
  },
  address: {
    "@type": "PostalAddress",
    addressCountry: "IN",
    ...(isFilled(site.contact.location)
      ? { addressLocality: site.contact.location }
      : {}),
  },
  ...(isFilled(site.contact.email) ? { email: site.contact.email } : {}),
  ...(isFilled(site.contact.phone) ? { telephone: site.contact.phone } : {}),
  ...(socials.length ? { sameAs: socials } : {}),
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${origin}/#website`, name: site.name, url: `${origin}/` },
    person,
    professionalService,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — calm, considered guidance`} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#0E5A52" />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    {
      structuredData.map((d) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(d)} />
      ))
    }

    <!-- Set the .js flag before first paint so reveal items don't flash. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {
      /* Cloudflare Web Analytics. Cookie-free and consent-banner-free, and it
         collects no personal data — but it IS a third-party script, so it is
         rendered only once a token exists. Until then the site keeps its zero
         third-party request record (FINISH-LINE.md O3, O4) and the privacy
         page continues to say, truthfully, that nothing is measured. */
      isFilled(site.analytics.cfBeaconToken) && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${site.analytics.cfBeaconToken}"}`}
        />
      )
    }
  </head>

  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-teal focus:px-4 focus:py-2 focus:text-onteal"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Gentle reveal-on-scroll. Inline so it's atomic with the .js flag:
         JS on → both run; JS off → neither runs and content stays visible. -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
