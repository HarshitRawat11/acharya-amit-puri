---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import ServiceIcon from "../../components/motifs/ServiceIcon.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import PetalDivider from "../../components/motifs/PetalDivider.astro";
import ContactCta from "../../components/home/ContactCta.astro";
import { site } from "../../data/site";
import { whatsappLink } from "../../lib/content";

// One static page per service, generated from the central config.
export const getStaticPaths = (() =>
  site.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;
const others = site.services.filter((s) => s.slug !== service.slug);
const wa = whatsappLink(
  `Namaste, I would like to enquire about the ${service.name} consultation.`,
);

// Prefer the service's own search title when it has one — it is written to
// stay under ~60 characters and to use the word people actually search for
// ("kundli", "palm reading", "name correction") rather than the brand tagline.
const title = service.seoTitle ?? `${service.name} — ${service.tagline} | ${site.name}`;
const description = service.summary;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL(Astro.site!).origin;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  serviceType: service.tagline,
  description: service.summary,
  url: canonical,
  areaServed: "India",
  // Point at the site-wide ProfessionalService node rather than describing a
  // second, duplicate one — otherwise search engines see two businesses.
  provider: { "@id": `${origin}/#service` },
};

// Questions specific to this service. These both deepen a page that was only
// ~330 words — thin for a commercial term — and earn the page its own FAQ
// rich-result, which previously only the home page could get.
const faqs = service.faqs ?? [];
const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

// Lets Google show Home › Services › this page instead of a bare URL.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "Services", item: `${origin}/services/` },
    { "@type": "ListItem", position: 3, name: service.name, item: canonical },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  structuredData={[serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <PageHero
    eyebrow={service.tagline}
    title={service.name}
    subtitle={service.summary}
  />

  <Section variant="paper">
    <Container class="grid gap-12 lg:grid-cols-12">
      <!-- Main content -->
      <div class="lg:col-span-8" data-reveal>
        <div class="flex items-start gap-5">
          <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-card border border-hair bg-surface text-gold shadow-soft">
            <ServiceIcon slug={service.slug} class="h-9 w-9" />
          </span>
          <p class="max-w-prose2 leading-relaxed text-muted">{service.intro}</p>
        </div>

        <div class="mt-10 space-y-10">
          <div>
            <h2 class="font-serif text-2xl text-teal">What it is</h2>
            <p class="mt-3 max-w-prose2 leading-relaxed text-muted">{service.whatItIs}</p>
          </div>

          <div>
            <h2 class="font-serif text-2xl text-teal">Who it's for</h2>
            <p class="mt-3 max-w-prose2 leading-relaxed text-muted">{service.whoItsFor}</p>
          </div>

          <div>
            <h2 class="font-serif text-2xl text-teal">What you receive</h2>
            <ul class="mt-4 space-y-3">
              {
                service.whatYouReceive.map((item) => (
                  <li class="flex max-w-prose2 gap-3 leading-relaxed text-muted">
                    <svg class="mt-1 h-4 w-4 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            service.note && (
              <p class="max-w-prose2 rounded-card border border-hair bg-surface-alt p-5 italic leading-relaxed text-muted">
                {service.note}
              </p>
            )
          }
        </div>
      </div>

      <!-- Sticky CTA aside -->
      <aside class="lg:col-span-4" data-reveal>
        <div class="rounded-card border border-hair bg-surface p-7 shadow-soft lg:sticky lg:top-24">
          <h2 class="font-serif text-2xl text-teal">Begin with {service.name}</h2>
          <p class="mt-3 max-w-prose2 leading-relaxed text-muted">
            Share a little about what you're seeking, and we'll take the next
            step together — calmly and without pressure.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <Button href="/contact" class="w-full">{site.primaryCta}</Button>
            {
              wa && (
                <Button href={wa} variant="ghost" class="w-full" target="_blank" rel="noopener noreferrer">
                  Chat on WhatsApp
                </Button>
              )
            }
          </div>
        </div>
      </aside>
    </Container>
  </Section>

  {
    faqs.length > 0 && (
      <Section variant="surface-alt" labelledby="service-faq-title">
        <Container>
          <div class="mx-auto max-w-2xl text-center" data-reveal>
            <p class="text-xs uppercase tracking-widest2 text-muted">Good to know</p>
            <h2 id="service-faq-title" class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
              {service.name} — your questions
            </h2>
            <PetalDivider class="mt-7" />
          </div>

          <div class="mx-auto mt-12 max-w-3xl space-y-4">
            {faqs.map((item) => (
              <details class="faq group rounded-card border border-hair bg-surface px-6 shadow-soft">
                <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-serif text-lg text-teal">
                  <span>{item.q}</span>
                  <svg
                    class="faq-chevron h-5 w-5 shrink-0 text-gold transition-transform duration-300"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <p class="max-w-prose2 pb-5 leading-relaxed text-muted">{item.a}</p>
              </details>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  <!-- Other services -->
  <Section variant="paper">
    <Container>
      <div class="text-center" data-reveal>
        <h2 class="font-serif text-2xl text-teal">
          Other areas of guidance
        </h2>
        <PetalDivider class="mt-6" />
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          others.map((s) => (
            <ServiceCard slug={s.slug} name={s.name} tagline={s.tagline} summary={s.summary} />
          ))
        }
      </div>
    </Container>
  </Section>

  <ContactCta />
</BaseLayout>
