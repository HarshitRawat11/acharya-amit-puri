---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import Mandala from "../../components/motifs/Mandala.astro";
import ContactCta from "../../components/home/ContactCta.astro";

// Published articles only (set draft: false in the .md file to publish).
const published = (await getCollection("articles")).filter((e) => !e.data.draft);
published.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" });

const title = "Articles — Vastu, Astrology & Numerology | Acharya Amit Puri";
const description =
  "Reflections and practical guidance on Vastu, Vedic astrology, kundli, numerology, Prakriti and palm reading from Acharya Amit Puri.";
// Lets Google show a breadcrumb trail in place of a bare URL.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: "Articles",
      item: new URL(Astro.url.pathname, Astro.site).href,
    },
  ],
};

---

<BaseLayout title={title} description={description} structuredData={[breadcrumbSchema]}>
  <PageHero
    eyebrow="Reflections"
    title="Articles & Writings"
    subtitle="Occasional notes and guidance on living in greater harmony."
  />

  <Section variant="paper">
    <Container>
      {
        published.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {published.map((a) => (
              <a
                href={`/articles/${a.id}`}
                class="group flex h-full flex-col rounded-card border border-hair bg-surface p-7 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-gold/70 hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
                data-reveal
              >
                <time datetime={a.data.pubDate.toISOString()} class="text-xs uppercase tracking-widest text-muted">
                  {fmt(a.data.pubDate)}
                </time>
                <h2 class="mt-3 font-serif text-xl text-teal">{a.data.title}</h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/90">{a.data.description}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
                  Read
                  <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="mx-auto max-w-xl rounded-card border border-hair bg-surface p-12 text-center shadow-soft" data-reveal>
            <Mandala simple class="mx-auto h-14 w-14 text-gold opacity-70" />
            <h2 class="mt-5 font-serif text-2xl text-teal">Writings are on the way</h2>
            <p class="mt-3 leading-relaxed text-muted">
              There are no articles published just yet. In the meantime, you're
              warmly welcome to explore the services or reach out with a question.
            </p>
            <div class="mt-7 flex flex-wrap justify-center gap-3">
              <Button href="/services">Explore services</Button>
              <Button href="/contact" variant="secondary">Get in touch</Button>
            </div>
          </div>
        )
      }
    </Container>
  </Section>

  {published.length > 0 && <ContactCta />}
</BaseLayout>
