---
/*
 * DESIGN OPTIONS — ⚠️ TEMPORARY, FOR THE CLIENT PRESENTATION ONLY.
 *
 * Removed on 2026-09-20 as G1 of FINISH-LINE.md, restored the same day for the
 * presentation with the removal already agreed: "will remove after feedback".
 * EXTRA under CLAUDE.md's routing rule, logged in BACKLOG.md, and NOT one of
 * the thirteen routes FINISH-LINE.md §1.1 defines. While it exists G1 is unmet.
 *
 *   TO REMOVE:
 *     git rm -r design-options src/lib/deck.ts src/pages/design-options.astro
 *     …drop the Design Options entry from src/components/Header.astro,
 *     then PURGE THE CLOUDFLARE CACHE — a plain request will report 404 while
 *     the edge still serves the page.
 *
 * ── Why the panes are scaled on a phone ──────────────────────────────────────
 * These five are desktop drafts and were never given mobile rules. Measured at
 * 375px they fall apart: the deck's own `.navright` stays 483px wide, a
 * decorative svg sits at 470px, and the about section refuses to stack, which
 * strands "Meet the Acharya" at x=220 inside a 128px box.
 *
 * Reflowing five draft layouts is a redesign. Scaling them is not: the client
 * sees each design whole and in proportion, which is what choosing between
 * directions actually needs. Full size on a laptop.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import PetalDivider from "../components/motifs/PetalDivider.astro";
import { loadDesignDeck } from "../lib/deck";

const { css, options } = loadDesignDeck();

/** The width these drafts were drawn at. Panes are scaled to fit below this. */
const DECK_WIDTH = 1180;

const title = "Design Options | Acharya Amit Puri";
const description =
  "Working document: five home-page directions for the Acharya Amit Puri website.";
---

<BaseLayout title={title} description={description} noindex>
  <PageHero
    eyebrow="Working document"
    title="Five design directions"
    subtitle="The wording and the six services are identical in all five. Only the design changes — colour, lettering, layout and ornament."
    cta={false}
  />

  <Section variant="surface-alt" class="!py-12">
    <Container>
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="leading-relaxed text-muted">
          Scroll through them, or jump to one. Each block below is a complete
          home page, top to bottom. They can be mixed — if the top of one and
          the service cards of another are the right pair, say so.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          The live site is built on <strong class="text-teal">Temple Tank</strong>,
          the first of the five.
        </p>
        <PetalDivider class="mt-7" />
        <nav class="mt-7 flex flex-wrap justify-center gap-2" aria-label="Design directions">
          {
            options.map((o, i) => (
              <a
                href={`#${o.id}`}
                class="rounded-full border border-hair px-4 py-2 text-sm text-ink transition-colors hover:border-gold hover:text-teal-dark"
              >
                {i + 1} · {o.name}
              </a>
            ))
          }
        </nav>
        <p class="mt-7 text-sm leading-relaxed text-muted sm:hidden">
          These are designs for a full-size screen, shown here scaled to fit
          your phone. Open the page on a laptop to read them properly.
        </p>
      </div>
    </Container>
  </Section>

  {
    options.map((o, i) => (
      <>
        <Section variant="paper" class="!py-10">
          <Container>
            <div id={o.id} class="scroll-mt-24" data-reveal>
              <p class="text-xs uppercase tracking-widest2 text-muted">
                Direction {i + 1} of {options.length}
                {i === 0 && <span class="ml-2 text-gold">· built</span>}
              </p>
              <h2 class="mt-3 font-serif text-3xl text-teal sm:text-4xl">{o.name}</h2>
              <p class="mt-4 max-w-prose2 leading-relaxed text-muted">{o.blurb}</p>
            </div>
          </Container>
        </Section>

        {/* The pane, scaled to fit rather than cropped. `zoom` is used rather
            than `transform: scale()` on purpose: zoom shrinks the layout box
            too, so the section below sits flush instead of leaving a tall gap
            where the unscaled height used to be. */}
        <div class="deck border-y border-hair">
          <div class="deckfit">
            <div class="deckinner" style={`width:${DECK_WIDTH}px`}>
              <Fragment set:html={o.html} />
            </div>
          </div>
        </div>
      </>
    ))
  }

  <Section variant="surface-alt">
    <Container>
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="font-serif text-2xl text-teal">A note on these previews</h2>
        <p class="mt-4 leading-relaxed text-muted">
          Testimonials, the portrait and the statistics appear as clearly
          labelled placeholders — no quotes have been invented. Headings use
          each direction's intended typeface where your device has it, and fall
          back gracefully where it does not.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>

<script is:inline define:vars={{ DECK_WIDTH }}>
  (function () {
    // Re-query every time rather than caching a NodeList at parse time. The
    // cached version silently did nothing: it ran before the panes were in the
    // document, hit its early return, and never registered the observer — so
    // every pane stayed at full width behind a scrollbar.
    function panes() {
      return document.querySelectorAll(".deckinner");
    }

    function fitOne(p) {
      var avail = p.parentElement && p.parentElement.clientWidth;
      if (!avail) return;
      var z = avail < DECK_WIDTH ? avail / DECK_WIDTH : 1;
      // Only write when it actually moves, so observing the parent of the
      // element we are scaling can never feed itself.
      if (Math.abs(parseFloat(p.style.zoom || 1) - z) > 0.001) p.style.zoom = z;
    }

    function fitAll() {
      var ps = panes();
      for (var i = 0; i < ps.length; i++) fitOne(ps[i]);
    }

    function start() {
      fitAll();
      // once more after the first paint, when the full-bleed rows have a width
      if (window.requestAnimationFrame) requestAnimationFrame(fitAll);

      // A window `resize` listener alone is not enough — it does not fire when
      // the containing box changes for any other reason, and under viewport
      // emulation it can miss entirely. Watch the box itself as well.
      var ps = panes();
      if (window.ResizeObserver && ps.length) {
        var ro = new ResizeObserver(fitAll);
        for (var j = 0; j < ps.length; j++) ro.observe(ps[j].parentElement);
      }
      window.addEventListener("resize", fitAll, { passive: true });
      window.addEventListener("load", fitAll);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

<style>
  /* Without JavaScript the pane simply overflows its wrapper, so the wrapper
     scrolls rather than the document. Nobody gets a sideways-scrolling page. */
  .deckfit {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .deckinner {
    margin-inline: auto;
  }
</style>

{/* The deck's stylesheet, every selector rewritten in scopeCss() to sit under
    `.deck`, so none of it can reach the rest of the site. */}
<style set:html={css}></style>
