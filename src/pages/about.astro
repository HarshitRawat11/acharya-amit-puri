---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Mascot from "../components/motifs/Mascot.astro";
import PetalDivider from "../components/motifs/PetalDivider.astro";
import ContactCta from "../components/home/ContactCta.astro";
import { site } from "../data/site";
import { filled, activeStats } from "../lib/content";

const bio = filled(site.about.bio);
const bioParas = bio ? bio.split(/\n\n+/) : [];
const stats = activeStats();

// Editable values — refine the wording freely.
const values = [
  {
    title: "Respect",
    body: "Every consultation begins with listening. Your beliefs, your pace, and your privacy are honoured throughout.",
  },
  {
    title: "Authenticity",
    body: "Guidance grounded in traditional knowledge — offered honestly, never with fear or exaggeration.",
  },
  {
    title: "Practicality",
    body: "Clear, livable suggestions you can act on gradually, in a way that genuinely fits your life.",
  },
];

const title = "About Acharya Amit Puri — Vastu & Astrology Consultant";
const description =
  "Meet Acharya Amit Puri — Vastu consultant, Vedic astrologer and numerologist. A calm, respectful approach to Vastu, kundli reading, Prakriti and palm reading.";
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="Meet the Acharya"
    title={site.name}
    subtitle={site.heroValueLine}
  />

  <Section variant="surface-alt">
    <Container class="grid items-start gap-12 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <!-- Stands in until a real portrait is supplied. -->
        <div class="relative mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-card border border-hair bg-gold-soft/25 shadow-soft">
          <div class="flex h-full flex-col items-center justify-center px-6 text-center">
            <Mascot halo class="h-48 w-48 text-teal sm:h-56 sm:w-56" />
            <p class="mt-2 font-serif text-lg text-teal">{site.name}</p>
          </div>
        </div>

        {
          stats.length > 0 && (
            <dl class="mt-8 grid grid-cols-2 gap-4">
              {stats.map((s) => (
                <div class="rounded-card border border-hair bg-surface p-4 text-center">
                  <dt class="font-serif text-2xl text-teal">{s.value}</dt>
                  <dd class="mt-1 text-[11px] uppercase tracking-widest text-muted">
                    {s.label}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      <div class="md:col-span-7" data-reveal>
        <p class="text-xs uppercase tracking-widest2 text-muted">The Acharya's path</p>
        <h2 class="mt-3 font-serif text-3xl text-teal">
          A calm approach to ancient guidance
        </h2>

        {
          bioParas.length > 0 ? (
            <div class="mt-5 space-y-4 leading-relaxed text-muted">
              {bioParas.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          ) : (
            <div class="mt-5 space-y-4 leading-relaxed text-muted">
              <p>
                Acharya Amit Puri offers guidance across Vastu, Vedic astrology,
                numerology, Prakriti and palmistry — meeting each person with
                patience and genuine care.
              </p>
              <p>
                A fuller account of the Acharya's background, training, and the
                philosophy behind the practice will follow here shortly.
              </p>
            </div>
          )
        }

        <Button href="/services" class="mt-8">Explore the services</Button>
      </div>
    </Container>
  </Section>

  <Section variant="paper">
    <Container>
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="text-xs uppercase tracking-widest2 text-muted">How I work</p>
        <h2 class="mt-3 font-serif text-3xl text-teal sm:text-4xl">
          Guided by three principles
        </h2>
        <PetalDivider class="mt-7" />
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {
          values.map((v, i) => (
            <div
              class="rounded-card border border-hair bg-surface p-7 shadow-soft"
              data-reveal
              style={`transition-delay:${i * 70}ms`}
            >
              <h3 class="font-serif text-xl text-teal">{v.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{v.body}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <ContactCta />
</BaseLayout>
