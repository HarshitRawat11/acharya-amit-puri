---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Mandala from "../components/motifs/Mandala.astro";
import { site } from "../data/site";
import {
  whatsappLink,
  phoneLink,
  emailLink,
  filled,
  isFilled,
  activeSocials,
} from "../lib/content";

const wa = whatsappLink(
  `Namaste, I would like to book a consultation with ${site.name}.`,
);
const tel = phoneLink();
const mail = emailLink();
const location = filled(site.contact.location);
const socials = activeSocials();

// The contact form posts to Web3Forms. Without an access key it would accept a
// message and silently discard it, so the form is not shown at all until the
// key is in place (see CONTENT.md §2) — a calm note stands in its place.
const keyReady = isFilled(site.form.accessKey);
// Is there any other way for a visitor to make contact right now?
const hasDirectContact = Boolean(tel || mail || wa);

const socialPaths: Record<string, string> = {
  instagram:
    "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm5.5-.5h.01",
  facebook: "M14 9h3V6h-3a3 3 0 0 0-3 3v2H8v3h3v7h3v-7h2.5l.5-3H14V9Z",
  youtube:
    "M22 8.5a3 3 0 0 0-2.1-2.1C18 6 12 6 12 6s-6 0-7.9.4A3 3 0 0 0 2 8.5 31 31 0 0 0 1.7 12 31 31 0 0 0 2 15.5a3 3 0 0 0 2.1 2.1C6 18 12 18 12 18s6 0 7.9-.4a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .3-3.5 31 31 0 0 0-.3-3.5ZM10 15V9l5 3-5 3Z",
};

const title = "Book a Vastu or Astrology Consultation | Acharya Amit Puri";
const description =
  "Book a consultation with Acharya Amit Puri — Vastu reports, kundli readings, numerology and name correction, Prakriti and palm reading. Available online across India.";
// Lets Google show a breadcrumb trail in place of a bare URL.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: "Book a Consultation",
      item: new URL(Astro.url.pathname, Astro.site).href,
    },
  ],
};

---

<BaseLayout title={title} description={description} structuredData={[breadcrumbSchema]}>
  <PageHero
    eyebrow="Get in touch"
    title="Book a Consultation"
    subtitle="Reach out with a little about what you're seeking. There's no pressure — only a calm conversation to begin."
  />

  <Section variant="paper">
    <Container class="grid gap-12 lg:grid-cols-12">
      <!-- Form -->
      <div class="lg:col-span-7" data-reveal>
        {!keyReady && (
          <div class="rounded-card border border-hair bg-surface p-8 shadow-soft">
            <Mandala simple class="h-12 w-12 text-gold opacity-70" />
            <h2 class="mt-5 font-serif text-2xl text-teal">
              The enquiry form is being prepared
            </h2>
            {
              hasDirectContact ? (
                <p class="mt-3 leading-relaxed text-muted">
                  It will be here shortly. In the meantime you are warmly welcome
                  to get in touch directly — by WhatsApp, phone or email. Every
                  message is read personally.
                </p>
              ) : (
                <p class="mt-3 leading-relaxed text-muted">
                  It will be here shortly, along with the full contact details.
                  Thank you for your patience — please do look in again soon.
                </p>
              )
            }
          </div>
        )}

        {keyReady && (
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value={site.form.accessKey} />
          <input type="hidden" name="subject" value={`New enquiry from the website — ${site.name}`} />
          <!-- Honeypot (spam protection) — left empty by real people -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="block text-sm font-medium text-ink">Your name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class="field mt-2" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="block text-sm font-medium text-ink">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" class="field mt-2" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-ink">Phone <span class="text-muted">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" class="field mt-2" />
            </div>
          </div>

          <div>
            <label for="service" class="block text-sm font-medium text-ink">What are you interested in?</label>
            <select id="service" name="service" class="field mt-2">
              <option value="Not sure yet">Not sure yet</option>
              {site.services.map((s) => (
                <option value={`${s.name} — ${s.tagline}`}>{s.name} — {s.tagline}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-ink">Your message</label>
            <textarea id="message" name="message" rows="5" required class="field mt-2"></textarea>
          </div>

          <button
            id="contact-submit"
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-teal px-7 py-3.5 font-medium text-onteal shadow-soft transition-all duration-200 hover:bg-teal-dark hover:shadow-lift focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send message
          </button>

          <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
        </form>
        )}
      </div>

      <!-- Details -->
      <aside class="lg:col-span-5" data-reveal>
        <div class="rounded-card border border-hair bg-surface-alt p-7">
          <h2 class="font-serif text-2xl text-teal">Other ways to reach me</h2>

          <ul class="mt-6 space-y-5 text-sm">
            {
              tel && (
                <li class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-hair text-teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5" aria-hidden="true"><path d="M4 5c0 8.3 6.7 15 15 15a2 2 0 0 0 2-2v-2.3a1 1 0 0 0-.8-1l-3.2-.7a1 1 0 0 0-1 .3l-1 1.2A12 12 0 0 1 8.2 9.9l1.2-1a1 1 0 0 0 .3-1l-.7-3.2a1 1 0 0 0-1-.8H6a2 2 0 0 0-2 2Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <a href={tel} class="text-ink transition-colors hover:text-teal">{site.contact.phone}</a>
                </li>
              )
            }
            {
              mail && (
                <li class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-hair text-teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5" aria-hidden="true"><path d="M3 7l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <a href={mail} class="break-all text-ink transition-colors hover:text-teal">{site.contact.email}</a>
                </li>
              )
            }
            {
              location && (
                <li class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-hair text-teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5" aria-hidden="true"><path d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11Z" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5"/></svg>
                  </span>
                  <span class="text-ink">{location}</span>
                </li>
              )
            }
            {
              !tel && !mail && !location && (
                <li class="text-muted">
                  Full contact details are being finalised and will appear here
                  very soon.
                </li>
              )
            }
          </ul>

          {
            wa && (
              <Button href={wa} class="mt-7 w-full" target="_blank" rel="noopener noreferrer">
                Chat on WhatsApp
              </Button>
            )
          }

          {
            socials.length > 0 && (
              <div class="mt-7 border-t border-hair pt-6">
                <p class="text-xs uppercase tracking-widest2 text-muted">Follow along</p>
                <ul class="mt-4 flex gap-3">
                  {socials.map((s) => (
                    <li>
                      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="flex h-10 w-10 items-center justify-center rounded-full border border-hair text-teal transition-colors hover:border-gold hover:text-gold">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5" aria-hidden="true">
                          <path d={socialPaths[s.key]} stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </Container>
  </Section>

  <!-- Progressive enhancement: AJAX submit with inline status; falls back to a
       normal POST if JavaScript is unavailable. -->
  <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      if (!form || !window.fetch) return;
      var status = document.getElementById("form-status");
      var btn = document.getElementById("contact-submit");

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var data = new FormData(form);
        status.textContent = "Sending…";
        status.style.color = "#4C5B56";
        if (btn) btn.disabled = true;

        fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (j.success) {
              form.reset();
              status.textContent =
                "Thank you — your message has been sent. I will be in touch soon.";
              status.style.color = "#0E5A52";
            } else {
              status.textContent =
                (j && j.message) ||
                "Sorry, something went wrong. Please try WhatsApp or email.";
              status.style.color = "#B42318";
            }
          })
          .catch(function () {
            status.textContent =
              "Network error. Please try WhatsApp or email instead.";
            status.style.color = "#B42318";
          })
          .finally(function () {
            if (btn) btn.disabled = false;
          });
      });
    })();
  </script>
</BaseLayout>
