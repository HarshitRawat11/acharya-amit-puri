# netlify CLI local state (site id, cached functions)
.netlify/

# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.*.local

# macOS / Windows / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Design-review screenshots (review/*.jpg).
#
# 13 MB of JPEGs that any of the harnesses beside them regenerate
# deterministically in about three minutes, against the production build.
# The harnesses and their raw measurements ARE committed, so the evidence is
# reproducible without carrying the images in git history. Delete these two
# lines if you would rather keep the screenshots permanently.
review/*.jpg
review/gate3/*.jpg
